    {
      "name": "Hotels",
      "item": [
        {
          "name": "Valid city with overlaps (delhi)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns 6 de-duplicated hotels', () => pm.expect(body).to.have.lengthOf(6));",
                  "",
                  "pm.test('Every item has name, price, supplier, commissionPct', () => {",
                  "    body.forEach(h => pm.expect(h).to.have.all.keys('name', 'price', 'supplier', 'commissionPct'));",
                  "});",
                  "pm.test('Hotel names are unique (de-duplicated)', () => {",
                  "    const names = body.map(h => h.name.toLowerCase());",
                  "    pm.expect(new Set(names).size).to.eql(names.length);",
                  "});",
                  "pm.test('Sorted by price ascending', () => {",
                  "    body.slice(1).forEach((h, i) => pm.expect(h.price).to.be.at.least(body[i].price));",
                  "});",
                  "pm.test('Holtin: cheaper Supplier B offer wins (5340)', () => {",
                  "    pm.expect(body.find(h => h.name === 'Holtin')).to.eql({ name: 'Holtin', price: 5340, supplier: 'Supplier B', commissionPct: 20 });",
                  "});",
                  "pm.test('Radison: cheaper Supplier A offer wins (5900)', () => {",
                  "    pm.expect(body.find(h => h.name === 'Radison')).to.eql({ name: 'Radison', price: 5900, supplier: 'Supplier A', commissionPct: 13 });",
                  "});",
                  "pm.test('No supplier failures reported', () => pm.response.to.not.have.header('X-Failed-Suppliers'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          }
        },
