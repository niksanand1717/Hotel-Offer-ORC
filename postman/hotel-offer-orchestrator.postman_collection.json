  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health - all suppliers up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Overall status is ok', () => pm.expect(body.status).to.eql('ok'));",
                  "pm.test('Both suppliers reported up', () => {",
                  "    pm.expect(body.suppliers['Supplier A'].status).to.eql('up');",
                  "    pm.expect(body.suppliers['Supplier B'].status).to.eql('up');",
                  "});",
                  "pm.test('Redis and Temporal up', () => {",
                  "    pm.expect(body.dependencies.redis.status).to.eql('up');",
                  "    pm.expect(body.dependencies.temporal.status).to.eql('up');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
