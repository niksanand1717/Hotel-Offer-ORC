# HTTP port for the API
PORT=3000
REDIS_URL=redis://localhost:6379
# How long de-duplicated offers stay in Redis
HOTEL_CACHE_TTL_SECONDS=300
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
# Temporal Cloud: set an API key, or an mTLS cert + key pair (either enables TLS)
TEMPORAL_API_KEY=
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=
# Where the worker and /health reach the mock supplier endpoints
SUPPLIER_BASE_URL=http://localhost:3000
SUPPLIER_TIMEOUT_MS=3000
# Worker health endpoint port (on Cloud Run it defaults to $PORT)
WORKER_HEALTH_PORT=
# Comma-separated supplier ids that start "down", e.g. A
SUPPLIERS_DOWN=
