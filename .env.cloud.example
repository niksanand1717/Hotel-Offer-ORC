# Copy to .env.cloud (gitignored). Used by:
#   - docker-compose.cloud.yml (Temporal Cloud from local Docker)
#   - scripts/deploy-cloud-run.sh (Google Cloud Run)

# --- Temporal Cloud (from your namespace page) ---
# gRPC endpoint, e.g. us-east-1.aws.api.temporal.io:7233
TEMPORAL_ADDRESS=
# Namespace id, e.g. hotel-offers.a1b2c
TEMPORAL_NAMESPACE=
# Settings -> API Keys (stored in Secret Manager on deploy)
TEMPORAL_API_KEY=

# --- Google Cloud Run deploy ---
GCP_PROJECT=
GCP_REGION=us-central1
# Redis reachable from Cloud Run (stored in Secret Manager on deploy):
#   Upstash / Redis Cloud: rediss://default:<password>@<host>:<port>
#   Memorystore:           redis://<private-ip>:6379 (also set VPC_NETWORK)
REDIS_URL=
# Only for Memorystore / private Redis: Direct VPC egress
VPC_NETWORK=
VPC_SUBNET=
